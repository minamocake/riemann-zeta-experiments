        given-names: David
    journal: "Advances in Mathematics"
    volume: 361
    year: 2020
    identifiers:
      - type: other
        value: "arXiv:1810.08843"
  - type: article
    title: "On Montgomery's pair correlation conjecture: a tale of three integrals"
    authors:
